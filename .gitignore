# --- Android / Gradle --------------------------------------------------------
# Build output and machine-local state: none of it is source, all of it is
# regenerated by `gradlew`. `local.properties` carries one developer's SDK path.
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
captures/
.cxx/
*.apk
*.aab
*.ap_
*.dex

# A release keystore is yours, never the repository's. See "Signing" in the
# README: whoever holds the key is whoever can ship an update to your install.
android/keystore.properties
*.jks
*.keystore

# --- Node / Python tooling ---------------------------------------------------
node_modules/
__pycache__/
*.pyc

# --- Local development scratch ----------------------------------------------
# Probes written against a running harness while working on the app, and the
# pre-restyle copy of the UI they were read alongside. Neither is part of the
# project.
_dsh_asar_*.js
_backup_ui_pre_restyle/

# The suites below write their own runtime state under `test/`, and the UI suite
# writes screenshots. Both are per-run artefacts; the curated screenshots the
# README shows live in docs/shots/.
test/_runtime*/
test/shots/
# plugin-check.mjs makes timestamped fixtures, and cleans up the directory it
# created but not these files: they belong to a run, not to the repository.
# The fixtures the suites read by name stay.
test/fixtures/nota-*.md
test/fixtures/lungo-*.md
test/fixtures/binario-*.dat

# --- Editors and OS ----------------------------------------------------------
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
